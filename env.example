# ---- Frontend (set in Netlify/Vercel "Environment variables"; these are PUBLIC) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key            # Supabase → Project Settings → API (anon/public key)
VITE_FREE_DAILY_MESSAGES=10                     # shown on the pricing page; keep equal to FREE_DAILY_MESSAGES
VITE_PAID_DAILY_MESSAGES=500
VITE_PRICE_MONTHLY_LABEL=$19 / month            # display text only; real prices live in your PayPal plans
VITE_PRICE_YEARLY_LABEL=$190 / year
# VITE_DEMO_EMAIL=                               # optional shared demo account (leave unset in production)
# VITE_DEMO_PASSWORD=

# NEVER put AI or PayPal secret keys in VITE_ variables: they would be shipped to every visitor.

# ---- Supabase Edge Function secrets (set with: supabase secrets set NAME=value) ----
# SITE_URL=https://your-domain.com               # where PayPal sends customers back after approving
# ALLOWED_ORIGINS=https://your-domain.com        # comma-separated; browsers from other sites are refused
# CONTACT_EMAIL=you@your-domain.com              # sent as User-Agent contact to open-data archives
#
# AI (set at least one; free services are tried first and the next one takes over if one fails):
# OMNIROUTE_BASE_URL=https://your-omniroute-host/v1   OMNIROUTE_API_KEY=   OMNIROUTE_MODEL=auto
#                                  # self-hosted OmniRoute gateway that pools many free AI providers
# GEMINI_API_KEY=                  # free: https://aistudio.google.com/apikey
# GROQ_API_KEY=                    # free: https://console.groq.com/keys
# OPENROUTER_API_KEY=              # free ":free" models: https://openrouter.ai/keys
# MISTRAL_API_KEY=                 # free Experiment plan: https://console.mistral.ai/api-keys
# NVIDIA_API_KEY=                  # free developer access: https://build.nvidia.com
# ANTHROPIC_API_KEY=   OPENAI_API_KEY=                 # paid
# AI_PROVIDER_ORDER=anthropic,gemini                    # optional: try these first
# ANTHROPIC_MODEL= OPENAI_MODEL= GEMINI_MODEL= GROQ_MODEL= OPENROUTER_MODEL= MISTRAL_MODEL= NVIDIA_MODEL=  # optional overrides
# FREE_DAILY_MESSAGES=10  PAID_DAILY_MESSAGES=500
#
# Billing (PayPal; create plans with scripts/paypal-setup.mjs):
# PAYPAL_ENV=sandbox            # or live
# PAYPAL_CLIENT_ID=...   PAYPAL_CLIENT_SECRET=...
# PAYPAL_WEBHOOK_ID=...         # from the webhook you register for paypal-webhook
# PAYPAL_PLAN_MONTHLY=P-...   PAYPAL_PLAN_YEARLY=P-...
# Interac e-Transfer needs no secrets: set the receiving email and CAD prices in the app (Payments (admin) screen).
#
# Voice (optional; one of):
# TTS_SERVER_URL=https://your-kokoro-server   TTS_SERVER_KEY=   TTS_VOICES=af_heart,am_adam,bf_emma,bm_george
# ELEVENLABS_API_KEY=   VOICE_ID_EN=
# GOOGLE_TTS_API_KEY=                            # for voice-story-generator
# GOOGLE_VISION_API_KEY=                         # family photo analysis
# (ELEVENLABS_API_KEY above also powers family voice preservation; OPENAI_API_KEY powers AI memory)
#
# Records search (optional, free keys):
# DPLA_API_KEY=   EUROPEANA_API_KEY=
